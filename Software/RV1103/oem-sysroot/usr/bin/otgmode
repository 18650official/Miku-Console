#!/bin/sh

# Define the absolute path of the OTG mode node
OTG_FILE="/sys/devices/platform/ff3e0000.usb2-phy/otg_mode"

# Function to display help information
print_help() {
    echo "Usage: otgmode [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  -s 1    Set USB to Host mode"
    echo "  -s 0    Set USB to Peripheral mode"
    echo "  -q      Query current mode (Returns 1 for Host, 0 for Peripheral)"
    echo "  -h      Display this help message"
}

# If no arguments are provided, show help and exit
if [ $# -eq 0 ]; then
    print_help
    exit 1
fi

# Check if the node file exists
if [ ! -f "$OTG_FILE" ]; then
    echo "Error: OTG mode file not found at $OTG_FILE"
    exit 1
fi

case "$1" in
    -s)
        if [ "$2" = "1" ]; then
            echo "host" > "$OTG_FILE"
            echo "USB mode set to Host (1)"
        elif [ "$2" = "0" ]; then
            # Write the standard peripheral string
            echo "peripheral" > "$OTG_FILE"
            echo "USB mode set to Peripheral (0)"
        else
            echo "Error: Invalid argument for -s. Use 1 (host) or 0 (peripheral)."
            exit 1
        fi
        ;;
    -q)
        # Read the current status
        MODE=$(cat "$OTG_FILE" 2>/dev/null)
        
        # Evaluate and return 0 or 1
        if [ "$MODE" = "host" ]; then
            echo "1"
        elif [ "$MODE" = "peripheral" ] || [ "$MODE" = "periphrial" ]; then
            echo "0"
        else
            echo "Error: Unknown mode state -> '$MODE'"
            exit 1
        fi
        ;;
    -h|--help|*)
        print_help
        ;;
esac

