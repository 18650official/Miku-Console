#!/bin/sh
#
# S85otg_watcher: Start/Stop the USB OTG auto-switch daemon.
#

NAME="OTG Auto Switcher"
DAEMON="/oem/usr/bin/otg_watcher"
PIDOF_NAME="otg_watcher"

log() {
    echo "S85otg_watcher: $1"
}

do_start() {
    log "Starting $NAME..."
    
    # Check if the daemon exists and is executable
    if [ ! -x "$DAEMON" ]; then
        log "Error: $DAEMON not found or not executable!"
        return 1
    fi
    
    # Launch in a new session to detach from init
    setsid $DAEMON > /dev/null 2>&1 &
}

do_stop() {
    log "Stopping $NAME..."
    if pidof $PIDOF_NAME > /dev/null 2>&1; then
        killall $PIDOF_NAME > /dev/null 2>&1
    fi
}

case "$1" in
  start)
    do_start
    ;;
  stop)
    do_stop
    ;;
  restart)
    do_stop
    sleep 1
    do_start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
esac

exit 0
